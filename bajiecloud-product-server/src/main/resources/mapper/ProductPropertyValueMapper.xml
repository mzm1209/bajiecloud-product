<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bajiezu.cloud.product.dal.mapper.ProductPropertyValueMapper">

    <resultMap id="BaseResultMap" type="com.bajiezu.cloud.product.dal.entity.ProductPropertyValue">
        <id column="id" property="id"/>
        <result column="property_id" property="propertyId"/>
        <result column="property_value" property="propertyValue"/>
        <result column="partner_id" property="partnerId"/>
        <result column="create_by" property="createBy"/>
        <result column="update_by" property="updateBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="is_deleted" property="isDeleted"/>
    </resultMap>

    <select id="selectByPropertyId" resultMap="BaseResultMap">
        SELECT * FROM product_property_value
        WHERE is_deleted = 0
          AND property_id = #{propertyId}
        ORDER BY create_time DESC
    </select>
</mapper>
