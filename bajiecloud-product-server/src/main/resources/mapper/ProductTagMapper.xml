<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bajiezu.cloud.product.dal.mapper.ProductTagMapper">

    <resultMap id="BaseResultMap" type="com.bajiezu.cloud.product.dal.entity.ProductTag">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="pic_url" property="picUrl"/>
        <result column="show_page" property="showPage"/>
        <result column="status" property="status"/>
        <result column="sort" property="sort"/>
        <result column="is_highlight" property="isHighlight"/>
        <result column="remark" property="remark"/>
        <result column="partner_id" property="partnerId"/>
        <result column="create_by" property="createBy"/>
        <result column="update_by" property="updateBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="is_deleted" property="isDeleted"/>
    </resultMap>

    <select id="queryList" resultMap="BaseResultMap">
        select * from product_tag
        where is_deleted = 0
        <if test="name != null and name != ''">
            and name like concat('%', #{name}, '%')
        </if>
        <if test="status != null">
            and status = #{status}
        </if>
        order by sort asc, create_time desc
        limit #{offset}, #{limit}
    </select>

    <select id="queryCount" resultType="java.lang.Long">
        SELECT COUNT(*) FROM product_tag
        WHERE is_deleted = 0
        <if test="name != null and name != ''">
            AND name LIKE CONCAT('%', #{name}, '%')
        </if>
        <if test="status != null">
            and status = #{status}
        </if>
    </select>

    <select id="querySimpleList" resultMap="BaseResultMap">
        select id, name from product_tag where is_deleted = 0 and status = 1
        <if test="showPage != null">
            and find_in_set(show_page, #{showPage})
        </if>
    </select>
</mapper>
