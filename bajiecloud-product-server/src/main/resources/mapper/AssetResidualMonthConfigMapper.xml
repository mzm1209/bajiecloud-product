<?xml version="1.0" encoding="UTF-8" ?><!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd"><mapper namespace="com.bajiezu.cloud.product.dal.mapper.AssetResidualMonthConfigMapper"><select id="selectByConfigId" resultType="com.bajiezu.cloud.product.dal.entity.AssetResidualMonthConfig">select * from asset_residual_month_config where residual_config_id=#{configId} and partner_id=#{partnerId} and is_deleted=0 order by global_month asc</select><insert id="insertBatch">insert into asset_residual_month_config(residual_config_id,partner_id,use_year,use_month,global_month,depreciation_rule_value,begin_value,depreciation_amount,residual_value,accumulated_depreciation_amount,current_purchase_amount,create_by,update_by,create_time,update_time,is_deleted) values <foreach collection="list" item="item" separator=",">(#{item.residualConfigId},#{item.partnerId},#{item.useYear},#{item.useMonth},#{item.globalMonth},#{item.depreciationRuleValue},#{item.beginValue},#{item.depreciationAmount},#{item.residualValue},#{item.accumulatedDepreciationAmount},#{item.currentPurchaseAmount},#{item.createBy},#{item.updateBy},#{item.createTime},#{item.updateTime},#{item.isDeleted})</foreach></insert><update id="logicDelByConfigId">update asset_residual_month_config set is_deleted=1,update_by=#{updateBy},update_time=#{updateTime} where residual_config_id=#{configId} and partner_id=#{partnerId} and is_deleted=0</update></mapper>
