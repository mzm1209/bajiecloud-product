<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bajiezu.cloud.product.dal.mapper.ProductBrandMapper">

    <resultMap id="BaseResultMap" type="com.bajiezu.cloud.product.dal.entity.ProductBrand">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="sort" property="sort"/>
        <result column="remark" property="remark"/>
        <result column="status" property="status"/>
        <result column="partner_id" property="partnerId"/>
        <result column="create_by" property="createBy"/>
        <result column="update_by" property="updateBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="is_deleted" property="isDeleted"/>
    </resultMap>


    <select id="queryList" resultMap="BaseResultMap">
        select * from product_brand where is_deleted = 0
        <if test="name != null and name != ''">
           and `name` like concat('%',#{name},'%')
        </if>
        order by create_time desc
        limit #{offset},#{limit}
    </select>

    <select id="queryCount" resultType="java.lang.Long">
        select count(*) from product_brand where is_deleted = 0
        <if test="name != null and name != ''">
            and `name` like concat('%',#{name},'%')
        </if>
    </select>

    <select id="querySimpleList" resultMap="BaseResultMap">
        select id, name, status, sort, remark from product_brand where is_deleted = 0
        <if test="status != null">
            and status = #{status}
        </if>
    </select>

    <select id="selectNameById" resultType="java.lang.String">
        select name from product_brand where id = #{id}
    </select>

    <select id="selectListByIds" resultMap="BaseResultMap">
        select * from product_brand where id in
        <foreach item="item" collection="ids" separator="," open="(" close=")" index="index">
            #{item}
        </foreach>
    </select>
</mapper>