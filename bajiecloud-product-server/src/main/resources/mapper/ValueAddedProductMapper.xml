<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bajiezu.cloud.product.dal.mapper.ValueAddedProductMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.bajiezu.cloud.product.dal.entity.ValueAddedProduct">
        <id column="id" property="id" />
        <result column="value_added_id" property="valueAddedId" />
        <result column="marketing_product_sku_id" property="marketingProductSkuId" />
        <result column="partner_id" property="partnerId" />
        <result column="create_by" property="createBy" />
        <result column="update_by" property="updateBy" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="is_deleted" property="isDeleted" />
    </resultMap>

    <insert id="batchInsert">
        insert into value_added_product (value_added_id, marketing_product_sku_id, partner_id, create_by, update_by,
                                         create_time, update_time, is_deleted)
        values
        <foreach collection="valueAddedProducts" item="item" separator=",">
            (
             #{item.valueAddedId}, #{item.marketingProductSkuId}, #{item.partnerId}, #{item.createBy}, #{item.updateBy},
             #{item.createTime}, #{item.updateTime}, #{item.isDeleted}
            )
        </foreach>
    </insert>
</mapper>