<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bajiezu.cloud.product.dal.mapper.ProductPropertyMapper">

    <resultMap id="BaseResultMap" type="com.bajiezu.cloud.product.dal.entity.ProductProperty">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="sort" property="sort"/>
        <result column="partner_id" property="partnerId"/>
        <result column="create_by" property="createBy"/>
        <result column="update_by" property="updateBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="is_deleted" property="isDeleted"/>
        <!-- 创建人用户名字段 -->
        <result column="create_by_name" property="creatorName"/>
    </resultMap>

    <select id="queryList" resultMap="BaseResultMap">
        select * from product_property
        where is_deleted = 0
        <if test="name != null and name != ''">
            and name like concat('%', #{name}, '%')
        </if>
        order by sort
        limit #{offset}, #{limit}
    </select>

    <select id="queryCount" resultType="java.lang.Long">
        select count(*) from product_property
        where is_deleted = 0
        <if test="name != null and name != ''">
            and name like concat('%', #{name}, '%')
        </if>
    </select>

    <select id="selectByName" resultMap="BaseResultMap">
        select * from product_property where name = #{name} and is_deleted = 0
    </select>

    <update id="logicDelById">
        update product_property set is_deleted = 1, update_by = #{updateBy}, update_time = #{updateTime}  where id = #{id}
    </update>

    <select id="queryAll" resultMap="BaseResultMap">
        select id, name from product_property where is_deleted = 0 order by sort
    </select>
</mapper>
