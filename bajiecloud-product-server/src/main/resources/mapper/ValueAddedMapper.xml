<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bajiezu.cloud.product.dal.mapper.ValueAddedMapper">

    <!-- 通用查询映射结果，字段映射建议使用下划线转驼峰，或保持与实体类一致 -->
    <resultMap id="BaseResultMap" type="com.bajiezu.cloud.product.dal.entity.ValueAdded">
        <id column="id" property="id" />
        <result column="code" property="code" />
        <result column="name" property="name" />
        <result column="status" property="status" />
        <result column="sale_price" property="salePrice" />
        <result column="renewal_price" property="renewalPrice" />
        <result column="strikethrough_price" property="strikethroughPrice" />
        <result column="service_overview" property="serviceOverview" />
        <result column="service_content" property="serviceContent" />
        <result column="pic_url" property="picUrl" />
        <result column="partner_id" property="partnerId" />
        <result column="create_by" property="createBy" />
        <result column="update_by" property="updateBy" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="is_deleted" property="isDeleted" />
    </resultMap>

    <sql id="listSql">
        where is_deleted = 0
        <if test="name != null">
            and name like concat('%',#{name},'%')
        </if>
        <if test="status != null">
            and status = #{status}
        </if>
        <if test="createTimeBegin != null">
            and create_time >= #{createTimeBegin}
        </if>
        <if test="createTimeEnd != null">
            and create_time &lt;= #{createTimeEnd}
        </if>
    </sql>

    <select id="queryIdAndNameByStatus" resultMap="BaseResultMap">
        select id, name from value_added where is_deleted = 0 and status = #{status}
    </select>

    <select id="selectListByQuery" parameterType="com.bajiezu.cloud.product.dal.dto.ValueAddedQuery" resultMap="BaseResultMap">
        select * from value_added <include refid="listSql"/>
        order by create_time desc
        <if test="offset != null and pageSize != null">
            limit #{offset},#{pageSize}
        </if>
    </select>

    <select id="selectCountByQuery" parameterType="com.bajiezu.cloud.product.dal.dto.ValueAddedQuery" resultType="java.lang.Long">
        select count(1) from value_added <include refid="listSql"/>
    </select>

    <select id="selectIdAndNamesByIds" resultType="com.bajiezu.cloud.product.controller.vo.IdAndNameVO">
        select id, name from value_added where id in
        <foreach item="item" collection="ids" open="(" separator="," close=")">
            #{item}
        </foreach>
    </select>
</mapper>