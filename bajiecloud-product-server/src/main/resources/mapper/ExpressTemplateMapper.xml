<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bajiezu.cloud.product.dal.mapper.ExpressTemplateMapper">

    <resultMap id="BaseResultMap" type="com.bajiezu.cloud.product.dal.entity.ExpressTemplate">
        <id column="id" property="id" />
        <result column="code" property="code" />
        <result column="template_name" property="templateName" />
        <result column="express_service_type" property="expressServiceType" />
        <result column="postage_type" property="postageType" />
        <result column="default_shipping_cost" property="defaultShippingCost" />
        <result column="remark" property="remark" />
        <result column="partner_id" property="partnerId" />
        <result column="create_by" property="createBy" />
        <result column="update_by" property="updateBy" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="is_deleted" property="isDeleted" />
    </resultMap>

    <select id="selectListByQuery" parameterType="com.bajiezu.cloud.product.dal.dto.ExpressTemplateQuery" resultMap="BaseResultMap">
        select * from express_template where is_deleted = 0
        <if test="templateName != null">
            and template_name = #{templateName}
        </if>
        <if test="status != null">
            and status = #{status}
        </if>
        order by create_time desc
        <if test = "offset != null">
            limit #{offset}, #{pageSize}
        </if>
    </select>

    <select id="selectCountByQuery" parameterType="com.bajiezu.cloud.product.dal.dto.ExpressTemplateQuery" resultType="java.lang.Long">
        select count(*) from express_template where is_deleted = 0
        <if test="templateName != null">
            and template_name = #{templateName}
        </if>
        <if test="status != null">
            and status = #{status}
        </if>
    </select>
</mapper>