<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bajiezu.cloud.product.dal.mapper.ProductBusinessCategoryMapper">

    <resultMap id="BaseResultMap" type="com.bajiezu.cloud.product.dal.entity.ProductBusinessCategory">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="parent_id" property="parentId"/>
        <result column="level" property="level"/>
        <result column="path" property="path"/>
        <result column="sort" property="sort"/>
        <result column="partner_id" property="partnerId"/>
        <result column="create_by" property="createBy"/>
        <result column="update_by" property="updateBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="is_deleted" property="isDeleted"/>
    </resultMap>

    <select id="selectByLevel" resultMap="BaseResultMap">
        select id, name, parent_id, level, path, sort from product_business_category where is_deleted = 0
        and level = #{level}
        limit #{offset}, #{pageSize}
    </select>

    <select id="selectCountByLevel" resultType="java.lang.Long">
        select count(1) from product_business_category where is_deleted = 0 and level = #{level}
    </select>

    <select id="batchSelectByPathPrefix" resultMap="BaseResultMap">
        select id, name, parent_id, level, path, sort from product_business_category
        where
        <foreach collection="categoryIds" item="categoryId" separator=" OR " open="(" close=")">
            path like CONCAT(#{categoryId}, ',%')
        </foreach>
        and is_deleted = 0
    </select>

    <select id="queryAll" resultMap="BaseResultMap">
        select id, name, parent_id, level, path, sort from product_business_category
        where is_deleted = 0
    </select>

    <select id="selectSelfAndParentsById" resultMap="BaseResultMap">
        select *
        from product_business_category
        where find_in_set(id, (
            select path
            from product_business_category
            where id = #{id}
        )) > 0
          and is_deleted = 0
        order by level;
    </select>

    <select id="selectListByIds" resultMap="BaseResultMap">
        select * from product_business_category where id in
        <foreach item="item" index="index" collection="list" open="(" separator="," close=")">
            #{item}
        </foreach>
    </select>
</mapper>
